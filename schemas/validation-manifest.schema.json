{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/technehub-labs/dea-catalog-business-processes/schemas/validation-manifest.schema.json",
  "title": "Validation Manifest (CR-BP-94-EXT-04)",
  "description": "The validation manifest is the machine-readable record of the per-record validation state produced by scripts/validate_readme_structure.py. The manifest is the input for CR-BP-94-EXT-05 (decomposition reconciliation) and any downstream tooling that needs per-record validation state. Schema version 1. Bump on structural change to the manifest format.",
  "type": "object",
  "required": [
    "manifest_schema_version",
    "generated_at",
    "generator",
    "parent_cr",
    "catalog_root",
    "summary",
    "findings",
    "records"
  ],
  "properties": {
    "manifest_schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Bump on structural change to the manifest format."
    },
    "generated_at": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date of manifest generation."
    },
    "generator": {
      "type": "string",
      "const": "scripts/validate_readme_structure.py",
      "description": "The script that produced the manifest."
    },
    "parent_cr": {
      "type": "string",
      "const": "CR-BP-94-EXT-04",
      "description": "The change request that authorises the manifest format."
    },
    "catalog_root": {
      "type": "string",
      "description": "Absolute or relative path to the catalog root that the manifest was generated from."
    },
    "summary": {
      "type": "object",
      "required": ["total_records", "by_level", "by_rule", "total_findings", "advisory_findings"],
      "properties": {
        "total_records": {
          "type": "integer",
          "description": "Number of records walked."
        },
        "by_level": {
          "type": "object",
          "description": "Record count by decomposition level (L0..L4 or ?).",
          "additionalProperties": {"type": "integer"}
        },
        "by_rule": {
          "type": "object",
          "description": "Findings count by rule (DOC-016..020).",
          "additionalProperties": {"type": "integer"}
        },
        "total_findings": {
          "type": "integer",
          "description": "Total number of findings."
        },
        "advisory_findings": {
          "type": "integer",
          "description": "Number of advisory findings (the EXT-04 validator is fully advisory in this slice; CR-BP-94-EXT-06 flips to blocking)."
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Flat list of findings. Each finding corresponds to a single (record, rule) pair that failed the rule.",
      "items": {
        "type": "object",
        "required": ["rule", "record_id", "diagnostic", "advisory", "level", "profile"],
        "properties": {
          "rule": {
            "type": "string",
            "enum": ["DOC-016", "DOC-017", "DOC-018", "DOC-019", "DOC-020"]
          },
          "record_id": {
            "type": "string",
            "description": "Canonical id of the record (the YAML `id` field)."
          },
          "level": {
            "type": "string",
            "enum": ["L0", "L1", "L2", "L3", "L4", "?"]
          },
          "profile": {
            "type": ["string", "null"],
            "description": "Documentation profile id (dea:profile-readme-l*-v2) or null if no profile was resolved."
          },
          "diagnostic": {
            "type": "string",
            "description": "Short prose describing the finding."
          },
          "missing_sections": {
            "type": "array",
            "items": {"type": "string"},
            "description": "DOC-016 only: the list of section-ids that were not found in the README."
          },
          "advisory": {
            "type": "boolean",
            "const": true,
            "description": "EXT-04 findings are advisory until EXT-06 is complete."
          }
        }
      }
    },
    "records": {
      "type": "array",
      "description": "Per-record validation state. One entry per record walked.",
      "items": {
        "type": "object",
        "required": ["record_id", "level", "type", "profile", "yaml_path", "readme_path", "readme_exists", "rules"],
        "properties": {
          "record_id": {"type": "string"},
          "level": {"type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "?"]},
          "type": {"type": ["string", "null"]},
          "profile": {"type": ["string", "null"]},
          "yaml_path": {"type": "string"},
          "readme_path": {"type": "string"},
          "readme_exists": {"type": "boolean"},
          "rules": {
            "type": "object",
            "description": "Per-rule pass state. The keys present depend on the record's level: DOC-016..018 are emitted for all records; DOC-019..020 are emitted for L0 only.",
            "properties": {
              "DOC-016": {
                "type": "object",
                "properties": {
                  "pass": {"type": "boolean"}
                }
              },
              "DOC-017": {
                "type": "object",
                "properties": {
                  "pass": {"type": "boolean"}
                }
              },
              "DOC-018": {
                "type": "object",
                "properties": {
                  "pass": {"type": "boolean"}
                }
              },
              "DOC-019": {
                "type": "object",
                "properties": {
                  "pass": {"type": "boolean"},
                  "details": {
                    "type": "object",
                    "properties": {
                      "has_yaml_metrics": {"type": "boolean"},
                      "has_placeholder": {"type": "boolean"},
                      "has_table": {"type": "boolean"},
                      "populated": {"type": "boolean"}
                    }
                  }
                }
              },
              "DOC-020": {
                "type": "object",
                "properties": {
                  "pass": {"type": "boolean"},
                  "details": {
                    "type": "object",
                    "properties": {
                      "has_yaml_charter": {"type": "boolean"},
                      "has_placeholder": {"type": "boolean"},
                      "has_three_rows": {"type": "boolean"},
                      "populated": {"type": "boolean"}
                    }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
