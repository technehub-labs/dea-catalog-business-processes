__pycache__/
*.pyc

# PR design scratch goes outside the repo going forward. The `archive/`
# subdirectory remains tracked as historical PR design history (see
# commits that moved the original 21 design notes under `01_plan/archive/`).
# New `pr-*.md` files at `01_plan/` are local-only design notes.
/01_plan/*.md
!/01_plan/archive/

# Generated map artefacts (scripts/generate_entity_map.py). Regenerate with:
#   python3 scripts/generate_entity_map.py -o out/entity-map-l0-l1.html \
#       --drilldown-dir out/drilldown
# The generator and its tests are tracked; the rendered output is derived
# state and is reproducible from the live catalogue at any revision.
/out/
